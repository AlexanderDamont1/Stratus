{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:full": "concurrently --kill-others-on-fail \"php artisan serve --host=0.0.0.0 --port=8000\" \"php artisan reverb:start\" \"php artisan queue:work --verbose --tries=3 --timeout=60\" \"php artisan schedule:work\" \"npm run dev\""
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-echo": "^2.3.3",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "pusher-js": "^8.5.0",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    }
}
